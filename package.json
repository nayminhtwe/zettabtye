    "@types/react": "~19.1.0",
    "babel-preset-expo": "^57.0.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "patch-package": "^8.0.1",
