{
  "name": "zettabyte-v2",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "fonts:setup": "bash scripts/setup-gill-sans-font.sh",
    "postinstall": "patch-package"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
